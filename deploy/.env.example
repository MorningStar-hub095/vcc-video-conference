# ============================================================
# VCC 视频会议系统 —— 部署环境变量样例
# 使用方式： cp .env.example .env   然后填写真实值
# 警告：.env 含密钥，禁止提交到仓库（见 deploy/.gitignore）
# ============================================================

# ---------- 服务端（PlayerHallServer）----------
# 监听端口：客户端三路 TCP（信令/音频/视频）均连此端口
SERVER_PORT=8000
# 镜像标签，用于回滚（回滚即把此值改回上一个标签后重跑 deploy.sh）
IMAGE_TAG=2026.10.13-1

# ---------- 数据库（MySQL）----------
# 应用连接用的账号（compose 会自动创建并授予 vcc 库权限）
DB_NAME=vcc
DB_USER=vcc
DB_PWD=请改成强口令
DB_IP=mysql
# 源码 packdef.h 未定义 DB_PORT，固定使用 3306；改端口需同步改源码
DB_PORT=3306

# MySQL root 口令（仅用于容器初始化与运维）
MYSQL_ROOT_PWD=请改成强口令
MYSQL_IMAGE=mysql:8.0

# ---------- 客户端（Windows Qt）----------
# 客户端连接的服务端 IP/域名（写入 config.ini 的 [Net] ip）
CLIENT_SERVER_IP=192.168.1.100
