moc_*.h
qrc_*.cpp
ui_*.h
Makefile.Debug
Makefile.Release
.qmake.stash
*.pro.user
*.pro.user.*

# ---------- 部署密钥与产物（绝不入库）----------
deploy/.env
deploy/.staging/
deploy/backups/
deploy/dist/
# TLS 证书与私钥：用 deploy/tls/gen-certs.sh 或 bare/tls/ca-init.sh 重新生成
deploy/certs/
*.sql.bak

# 私钥/证书扩展名兜底 —— 不按路径、按后缀，目录改名也不会漏保护
*.key
*.p12
*.pfx
*.crt
*.csr
*.pem

# ---------- 巨型第三方 / 工具链（不入库，改用文档说明获取方式）----------
MSYS2/
**/node_modules/
vcc-client/ffmpeg-4.2.2/
vcc-client/SDL2-2.0.10/

# 【修复-P0（发布阻断）：*.a/*.lib 构建产物规则误伤 vendored 静态库】
# 修改原因: 上方"构建产物"区的 *.a / *.lib 通配规则把两个小型 vendored 第三方
#           静态库也一并排除了——vcc-client/AudioApi/opus/lib/libopus.a 与
#           vcc-client/AudioApi/WebRtc_Vad/signalProcess.lib。它们不在仓库里时
#           克隆后客户端【链接必失败】（2026-10-21 全量构建实测复现），且二者
#           无公开一致的获取渠道，属于发布阻断项。
# 修改效果: 用 ! 例外规则精确放行这两个文件（合计 <1.5MB），其余 *.a/*.lib
#           构建产物仍被忽略；配合 git add -f 入库后克隆即可链接。
# 原代码: （无例外规则，两库被 *.a/*.lib 规则吞掉）
!vcc-client/AudioApi/opus/lib/libopus.a
!vcc-client/AudioApi/WebRtc_Vad/signalProcess.lib

# ---------- 原始素材（不入库）----------
# 原项目带 193 张表情 + 37 张 UI 图，版权归属不明，全部排除。
# 但 logindialog.ui / vccdialog.ui 共 6 处通过 resource.qrc 引用了其中 4 张，
# 文件缺失会导致「编译通过但界面空白」。这 4 张改用 tools/make_placeholder_assets.py
# 生成的自绘中性占位图入库（同名同尺寸，合计约 5KB）。
# 若要换回自有素材，把图放进下面两个目录后删掉对应 .gitignore 规则即可。
# vcc-client/bq/
# vcc-client/tx/
# vcc-client/images/

# ---------- Python 缓存（内含源码字节码，禁止入库）----------
__pycache__/
*.py[cod]
*.egg-info/

# ---------- 密钥 / 证书（防御性兜底：任何新产生的私钥都不得入库）----------
*.key
*.p12
*.pfx
*.keystore
# 方案 B 实验室产物（含 CA 私钥与用户私钥，一律本地清理）
deploy/bare/tls/lab/_work/

# ---------- 调试 / 临时残留 ----------
min_test/
clean_test/
full_copy_test/
dll_only_test/
t0123456789*/
*_log*.txt
*.log
core
core.*
vgcore.*

